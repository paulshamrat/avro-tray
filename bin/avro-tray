#!/usr/bin/env bash
# Entrypoint wrapper for avro-tray

# Resolve symlinks so REPO_DIR is always the real project root
SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "${SCRIPT_PATH}")" && pwd)"
REPO_DIR="$(cd "${SCRIPT_DIR}/.." && pwd)"

# Prefer active virtualenv/conda python, then user miniforge/conda if present, then system python3
if [ -n "${VIRTUAL_ENV}" ] && [ -x "${VIRTUAL_ENV}/bin/python3" ]; then
    PYTHON_BIN="${VIRTUAL_ENV}/bin/python3"
elif [ -n "${CONDA_PREFIX}" ] && [ -x "${CONDA_PREFIX}/bin/python3" ]; then
    PYTHON_BIN="${CONDA_PREFIX}/bin/python3"
elif [ -x "${HOME}/miniforge3/bin/python3" ]; then
    PYTHON_BIN="${HOME}/miniforge3/bin/python3"
elif [ -x "${HOME}/miniconda3/bin/python3" ]; then
    PYTHON_BIN="${HOME}/miniconda3/bin/python3"
elif [ -x "${HOME}/anaconda3/bin/python3" ]; then
    PYTHON_BIN="${HOME}/anaconda3/bin/python3"
elif command -v python3 >/dev/null 2>&1; then
    PYTHON_BIN="$(command -v python3)"
else
    PYTHON_BIN="/usr/bin/python3"
fi

export PYTHONPATH="${REPO_DIR}/src:${PYTHONPATH}"
exec "${PYTHON_BIN}" -m avro_tray.main "$@"
